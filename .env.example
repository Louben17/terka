# Supabase – tabulka `terka` se sloupci `text` a `autor`
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Jen pro administraci (zápis výzev) – nikdy nesdílet
SUPABASE_SERVICE_ROLE_KEY=

# Přihlášení do /admin
ADMIN_USERNAME=uklidovaguru
ADMIN_PASSWORD=
# Náhodný dlouhý řetězec pro podpis session cookie (např. `openssl rand -base64 32`)
ADMIN_SESSION_SECRET=

# SEO
# Kanonická adresa webu (výchozí https://www.uklidovaguru.cz)
NEXT_PUBLIC_SITE_URL=https://www.uklidovaguru.cz
# Ověřovací kód z Google Search Console (metoda „Značka HTML“ – jen hodnota content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
